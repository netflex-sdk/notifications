{
    "name": "netflex/notifications",
    "description": "Netflex Notifications Mail Driver for Laravel",
    "type": "library",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "require": {
        "illuminate/bus": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/support": "^13.0",
        "mustache/mustache": "^2.14.1",
        "netflex/api": "^7.0",
        "netflex/foundation": "^7.0",
        "netflex/renderer": "^7.0",
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Netflex\\Notifications\\": ""
        },
        "files": [
            "helpers.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Netflex\\Notifications\\Providers\\NotificationsServiceProvider"
            ]
        }
    }
}
